{
  "name": "pi-agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npm run clean && npm run build:server && npm run build:web",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev": "concurrently \"tsx watch src/server/index.ts\" \"vite\"",
    "start": "node dist/server/index.js",
    "check": "biome ci .",
    "check:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "e2e:server": "tsx tests/e2e/support/server.ts",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "ci": "npm run check && npm run check:e2e && npm test && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hono/node-server": "^2.1.0",
    "@hono/typebox-validator": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "hono": "^4.13.2",
    "i18next": "^26.3.6",
    "jose": "^6.2.8",
    "postgres": "^3.4.9",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.3.13",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
